.env
*.code-workspace
**/*.rs.bk
/.coverage/
/.benchmarks/
/.idea/
/.vscode/launch.json
/data.db
/database.db
/database.json.bz2
/flamegraph.svg
/storage/
/target
/.tmp/
/tracker.*
/tracker.toml
callgrind.out
codecov.json
integration_tests_sqlite3.db
lcov.info
perf.data*
repomix-output.xml
rustc-ice-*.txt

# Python bytecode, which every interpreter run regenerates
__pycache__/
*.py[cod]

# Bytecode and native binaries of other toolchains (Cargo keeps its own in /target)
*.class
*.bc
*.wasm
*.o
*.obj
*.a
*.lib
*.so
*.so.[0-9]*
*.dylib
*.dll
*.exe
*.pdb
*.dSYM/

# Core dumps named with a process id
core.[0-9]*
